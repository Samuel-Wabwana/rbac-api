<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>{{name}}</title>
    <style>
      {{#if fontSrc}}
      @font-face {
        font-family: "{{fontFamily}}";
        src: url("{{{fontSrc}}}") format("{{fontFormat}}");
        font-weight: 400;
        font-style: normal;
      }
      {{/if}}
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: {{#if fontFamily}}"{{fontFamily}}", {{/if}}Arial, Helvetica, sans-serif;
        color: #1a1a1a;
      }
      .card {
        padding: 48px;
      }
      h1 {
        margin: 0 0 16px;
        font-size: 28px;
      }
      p {
        margin: 0;
        font-size: 16px;
      }
      .label {
        color: #555;
      }
      .photo {
        display: block;
        max-width: 160px;
        max-height: 160px;
        margin: 0 0 16px;
        object-fit: cover;
      }
    </style>
  </head>
  <body>
    <section class="card">
      {{#image photo}}
      <img class="photo" src="{{{src}}}" alt="" />
      {{/image}}
      <h1>{{name}}</h1>
      <p><span class="label">Table :</span> {{table}}</p>
    </section>
  </body>
</html>
