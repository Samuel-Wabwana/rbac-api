<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>{{name}}</title>
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        color: #1a1a1a;
      }
      .card {
        padding: 48px;
      }
      h1 {
        margin: 0 0 16px;
        font-size: 28px;
      }
      p {
        margin: 0;
        font-size: 16px;
      }
      .label {
        color: #555;
      }
      .photo {
        display: block;
        max-width: 160px;
        max-height: 160px;
        margin: 0 0 16px;
        object-fit: cover;
      }
    </style>
  </head>
  <body>
    <section class="card">
      {{#image photo}}
      <img class="photo" src="{{{src}}}" alt="" />
      {{/image}}
      <h1>{{name}}</h1>
      <p><span class="label">Table :</span> {{table}}</p>
    </section>
  </body>
</html>
